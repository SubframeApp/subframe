{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "subframe",
  "description": "Design UI for your codebase. Developers and designers can import design systems into Subframe, explore and edit pages and components, and implement designs in your app.",
  "version": "1.2.4",
  "author": {
    "name": "Subframe"
  },
  "homepage": "https://subframe.com",
  "repository": "https://github.com/SubframeApp/subframe",
  "license": "MIT",
  "keywords": [
    "design",
    "design-system",
    "ui",
    "mockups",
    "components",
    "prototyping",
    "react",
    "tailwind",
    "frontend"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Subframe",
        "category": "Design",
        "capabilities": [
          "Read",
          "Write"
        ],
        "shortDescription": "Design UI for your codebase",
        "longDescription": "Developers and designers can import design systems into Subframe, explore and edit pages and components, and implement designs in your app.",
        "developerName": "Subframe",
        "websiteURL": "https://www.subframe.com",
        "privacyPolicyURL": "https://policies.subframe.com/privacy",
        "termsOfServiceURL": "https://policies.subframe.com/tos",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/icon.png"
      }
    }
  }
}
