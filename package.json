{
  "name": "subframe",
  "private": true,
  "scripts": {
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "ts": "turbo run ts",
    "test": "turbo run test",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release": "npm run build-for-publish --workspace=@subframe/cli && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "prettier": "2.8.8",
    "turbo": "2.11.10",
    "typescript": "5.8.3"
  },
  "packageManager": "npm@11.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.0.0"
  }
}
